<odoo>

    <record id="view_unicah_tes_list" model="ir.ui.view">
        <field name="name">unicah.tes.list</field>
        <field name="model">unicah.tes</field>
        <field name="arch" type="xml">
            <list string="Registros TES">
                <field name="name"/>
                <field name="estudiante_id"/>
                <field name="fecha_inicio"/>
                <field name="fecha_fin"/>
                <field name="horas_realizadas"/>
                <field name="horas_pendientes"/>
                <field name="estado"/>
            </list>
        </field>
    </record>

    <record id="view_unicah_tes_actividad_list" model="ir.ui.view">
        <field name="name">unicah.tes.actividad.list</field>
        <field name="model">unicah.tes.actividad</field>
        <field name="arch" type="xml">
            <list string="Actividades TES">
                <field name="name"/>
                <field name="tes_id"/>
                <field name="fecha"/>
                <field name="horas"/>
            </list>
        </field>
    </record>

   
    <record id="view_unicah_tes_form" model="ir.ui.view">
        <field name="name">unicah.tes.form</field>
        <field name="model">unicah.tes</field>
        <field name="arch" type="xml">
            <form string="Registro TES">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Referencia TES"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="estudiante_id"/>
                            <field name="fecha_inicio"/>
                            <field name="fecha_fin"/>
                        </group>
                        <group>
                            <field name="estado"/>
                            <field name="horas_realizadas" readonly="1"/>
                            <field name="horas_pendientes" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Actividades realizadas">
                            <field name="actividad_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="fecha"/>
                                    <field name="horas"/>
                                    <field name="descripcion"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_unicah_tes" model="ir.actions.act_window">
        <field name="name">Trabajo Educativo Social</field>
        <field name="res_model">unicah.tes</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_unicah_tes_root"
              name="TES UNICAH"
              sequence="50"/>

    
    <menuitem id="menu_unicah_tes"
              name="Registros TES"
              parent="menu_unicah_tes_root"
              action="action_unicah_tes"
              sequence="10"/>


</odoo>
